.classpath
.project
.settings/
*.iml
.idea/
.DS_Store
dependency-reduced-pom.xml

# The ICU data file: 10 MB, and tools/icu-data.sh builds it from the published release in a minute.
# Checking it in would put a binary in the history for something a script reproduces exactly.
compiler/rt/android/external/icu/icu4c/source/data/icudt*.dat

# The generated C header for that data, 27 MB of "0x1f, 0x8b, ..." — tools/icu-header.py expands
# it from icudt68l.dat.gz, which IS checked in at 4.4 MB. The gzip is the artefact worth keeping in
# the history: the header is six bytes of text per byte of data and no editor wants to open it.
compiler/rt/android/libcore.luni4/src/main/native/icudt*.dat.gz.h
